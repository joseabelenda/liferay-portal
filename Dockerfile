FROM azul/zulu-openjdk:8u302

EXPOSE 8080 9200 11311

COPY /bundle /opt/liferay/bundles

#Setup ENVs
ENV LIFERAY_ADMIN_PERIOD_EMAIL_PERIOD_FROM_PERIOD_ADDRESS test@liferay.com
ENV LIFERAY_ADMIN_PERIOD_EMAIL_PERIOD_FROM_PERIOD_NAME Test Test
ENV LIFERAY_COMPANY_PERIOD_DEFAULT_PERIOD_LOCALE en_US
ENV LIFERAY_COMPANY_PERIOD_DEFAULT_PERIOD_WEB_PERIOD_ID liferay.com
ENV LIFERAY_DEFAULT_PERIOD_ADMIN_PERIOD_EMAIL_PERIOD_ADDRESS_PERIOD_PREFIX test
ENV LIFERAY_JDBC_PERIOD_DEFAULT_PERIOD_ACQUIRE_UPPERCASER_ETRY_UPPERCASEA_TTEMPTS 5
ENV LIFERAY_LIFERAY_PERIOD_HOME /opt/liferay/bundles
ENV LIFERAY_SETUP_PERIOD_WIZARD_PERIOD_ENABLED false

#Dev ENVs
ENV LIFERAY_JAVASCRIPT_PERIOD_FAST_PERIOD_LOAD false
ENV LIFERAY_MINIFIER_PERIOD_ENABLED true
ENV LIFERAY_THEME_PERIOD_CSS_PERIOD_FAST_PERIOD_LOAD_PERIOD_CHECK_PERIOD_REQUEST_PERIOD_PARAMETER true
ENV LIFERAY_THEME_PERIOD_IMAGES_PERIOD_FAST_PERIOD_LOAD_PERIOD_CHECK_PERIOD_REQUEST_PERIOD_PARAMETER true

CMD chmod -R 777 bundle

CMD /opt/liferay/bundles/tomcat-9.0.56/bin/catalina.sh run